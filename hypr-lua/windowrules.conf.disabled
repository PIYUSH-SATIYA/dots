windowrule = suppress_event maximize, match:class .*

# XWayland drag fix
windowrule = no_focus on, match:class ^$, match:title ^$, match:xwayland 1, match:float 1

# Rules for 'floating_term'
windowrule = match:class ^(floating_impala)$, float on, size 1000 600, center on

# Rules for 'floating_bluetui'
windowrule = match:class ^(floating_bluetui), float on, size 1000 600, center on

# Rules for 'floating_btop'
windowrule = match:class ^(floating_btop), float on, size 1200 800, center on

# zathura transperancy
# windowrule = match:class ^(org\.pwmt\.zathura)$, opacity 0.85 0.65
