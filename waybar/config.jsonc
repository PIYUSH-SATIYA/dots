{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/cpu-cores",
        "cpu",
        "memory",
        "temperature",
        "load",
        "battery",
        "power-profiles-daemon",
        "bluetooth",
        "group/audio",
        "group/bright",
        "network",
        "tray",
        "custom/ctlcenter",
        "custom/start"
    ],

    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "group/bright": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": ["backlight", "backlight/slider"]
    },

    "include": [
        "~/.config/waybar/modules.jsonc"
    ]
}
