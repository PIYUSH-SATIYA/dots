{
  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
    "persistent-workspaces": { "*": 5 },
    "cursor": true,
    "onclick": "activate"
  },

  "mpris": {
    "format": " {artist} - {title}",
    "format-paused": " {artist} - {title}",
    "format-stopped": "",
    "tooltip-format": "{album}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    "max-length": 35
  },

  "custom/cpu-cores": {
    "exec": "~/.config/waybar/scripts/cpu-cores.sh",
    "interval": 2,
    "return-type": "json",
    "tooltip": true
  },

  "cpu": {
    "interval": 3,
    "format": " CPU {usage}%",
    "tooltip": false,
    "cursor": true,
    "states": { "warning": 65, "critical": 90 }
  },

  "memory": {
    "interval": 3,
    "format": " MEM {used:0.1f}G",
    "tooltip-format": "RAM: {percentage}% used ({used:0.1f}G / {total:0.1f}G)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
    "states": { "warning": 65, "critical": 90 }
  },

  "temperature": {
    // "hwmon-path": "/sys/class/hwmon/hwmon7/temp1_input",
    "thermal-zone": 9,
    "interval": 5,
    "format": "{icon} {temperatureC}°",
    "tooltip-format": "CPU package: {temperatureC}°C",
    "critical-threshold": 80,
    "format-icons": ["", "", "", "", ""]
  },

  "load": {
    "interval": 10,
    "format": " {load1}",
    "tooltip-format": "load average\n1m:  {load1}\n5m:  {load5}\n15m: {load15}",
    "cursor": true
  },

  "battery": {
    "interval": 20,
    "full-at": 100,
    "tooltip": true,
    "format-full": "󰂄 {capacity}%",
    "format": "{icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-time": "{H}:{M:02}",
    "format-charging": " {capacity}% ({time})",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂂", "󰁹"],
    "states": { "warning": 30, "critical": 15 }
  },

"power-profiles-daemon": {
  "format": "{icon}",
  "tooltip-format": "{profile}\nclick to cycle",
  "format-icons": {
    "performance": "󰓅",
    "balanced": "󰾅",
    "power-saver": "󰌪"
  }
},

"bluetooth": {
  "format-disabled": "󰂲",
  "format-off": "󰂲",
  "format-no-controller": "󰂲",
  "format-on": "󰂯",
  "format-connected": "󰂱 {device_alias}",
  "format-connected-battery": "󰂱 {device_alias}",

  "tooltip-format": "Bluetooth enabled",
  "tooltip-format-disabled": "Bluetooth disabled",
  "tooltip-format-off": "Bluetooth disabled",

  "tooltip-format-connected":
      "{device_alias}",

  "tooltip-format-connected-battery":
      "{device_alias}\nBattery: {device_battery_percentage}%",

  "on-click":
      "hyprctl dispatch \"hl.dsp.exec_cmd('kitty --class floating_bluetui bluetui')\""
},

"pulseaudio": {
  "format": "{icon}",
  "format-muted": "󰝟",

  "tooltip-format": "{volume}%",

  "on-click":
      "pactl set-sink-mute @DEFAULT_SINK@ toggle",

  "on-click-right":
      "hyprctl dispatch hl.dsp.exec_command(\"pavucontrol -t 4\")",

  "scroll-step": 2,

  "format-icons": {
    "default": [
      "󰕿",
      "󰖀",
      "󰕾"
    ]
  }
},

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "cursor": true
  },

  "backlight": {
    "scroll-step": 2,
    "format": "{icon}",
    "tooltip-format": "brightness: {percent}%",
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"]
  },

  "backlight/slider": {
    "min": 5,
    "max": 100,
    "cursor": true
  },

  "network": {
    "interface": "wlan0",
    "interval": 10,
"format-wifi": "󰤨 {essid}",
"format-disconnected": "󰤭",
"format-disabled": "󰤮",
"format-ethernet": "󰈀",
    "tooltip-format": "{essid}\n\nfrequency: {frequency}GHz\nstrength: {signalStrength}%\n\n {bandwidthUpBytes}    {bandwidthDownBytes}",
    "on-click": "hyprctl dispatch \"hl.dsp.exec_cmd('kitty --class floating_impala impala')\"",
    "on-click-right": "iwctl station wlan0 scan",
  },

  "tray": {
    "icon-size": 13,
    "spacing": 10,
    "cursor": true
  },

"clock": {
  "timezone": "Asia/Kolkata",

  "interval": 30,

  "format": "{:%H:%M}",
  "format-alt": "{:%a %d %b %Y}",

  "on-click": "mode",

  "tooltip-format":
      "<tt><small>{calendar}</small></tt>",

  "on-click-right":
      "hyprctl dispatch \"hl.dsp.exec_cmd('kitty --class=peaclock -e peaclock')\"",

  "calendar": {
    "mode": "year",
    "weeks-pos": "right",
    "mode-mon-col": 3,

    "format": {
      "weeks": "<b>W{}</b>",
      "today":
        "<span foreground='#89b4fa'><b><u>{}</u></b></span>"
    }
  }
},

  "custom/start": {
    "format": "",
    "tooltip": false,
    "on-click": "walker -t pywal"
  },

}
