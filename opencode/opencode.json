{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "yarn lint": "allow",
      "cat": "allow",
      "touch": "allow",
      "rm": "ask", 
      "sudo": "ask"
    },
    "edit": {
      "*": "ask",
      "src/*": "allow"
    }
  },
  "plugin": ["@mohak34/opencode-notifier@latest"]
}
